# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated from android/local.properties for Flutter REST API calls.
/android/dart_defines.local.env

# Flutter ephemeral build folders
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/

